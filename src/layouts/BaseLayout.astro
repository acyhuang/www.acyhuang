---
import Analytics from '@vercel/analytics/astro'
import { loadPreviewMap } from '../lib/link-previews'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Allison Huang',
  description = 'Notes by Allison Huang',
} = Astro.props
const linkPreviews = loadPreviewMap()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg?v=3" />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <slot />
    <aside
      id="external-link-preview"
      class:list={[
        'group pointer-events-none fixed z-50 w-[min(18rem,calc(100vw-1.5rem))] overflow-hidden',
        'rounded-xl border border-(--link-highlight) bg-(--page-background) text-(--page-text) shadow-md',
        'opacity-0 data-open:opacity-100 has-data-failed:invisible',
        'motion-safe:not-data-open:translate-y-1 motion-safe:not-data-open:scale-98',
        'motion-safe:not-data-open:data-[placement=below]:-translate-y-1',
        'transition-[opacity,translate,scale] duration-160 ease-strong-out',
        // Reduced motion: opacity only, as a 200ms plain-ease fade (animate skill).
        'motion-reduce:transition-opacity motion-reduce:duration-200 motion-reduce:ease-[ease] data-instant:transition-none',
        'data-toast:not-data-quick:duration-400 data-toast:not-data-quick:ease-[ease]',
        'motion-reduce:data-toast:not-data-quick:duration-400',
      ]}
      aria-hidden="true"
      data-external-preview
    >
      <div class="group/media aspect-8/5 bg-(--link-highlight)" data-external-preview-media>
        <img
          class="block size-full object-cover opacity-0 transition-opacity duration-0 ease-[ease] group-data-loaded/media:duration-200 group-data-instant:transition-none group-data-loaded/media:opacity-100"
          alt=""
          data-external-preview-image
        />
      </div>
    </aside>
    <script id="link-previews" type="application/json" is:inline set:html={JSON.stringify(linkPreviews)}></script>
    <script>
      import { previewKey } from '../lib/preview-url'

      const preview = document.querySelector<HTMLElement>('[data-external-preview]')
      // Thumbnails are generated at build time and keyed like `previewKey`.
      const linkPreviews: Record<string, string> = JSON.parse(
        document.getElementById('link-previews')?.textContent || '{}',
      )
      const hoverQuery = window.matchMedia('(hover: hover) and (pointer: fine)')
      // Links in body text, as opposed to the site title and footer.
      const BODY_LINKS = '.note-prose a[href]'
      let activeExternalLink: HTMLAnchorElement | null = null
      let previewTimer: number | undefined

      type Box = { top: number, bottom: number, left: number, right: number }

      // Pinch zoom only (not ⌘ +). The tolerance absorbs rounding differences.
      const isPinchZoomed = () => (window.visualViewport?.scale ?? 1) > 1.01

      const placeCard = (card: HTMLElement, link: HTMLAnchorElement, avoid: Box[] = []): Box => {
        const linkRect = link.getBoundingClientRect()
        // Layout size, so the closed state's scale doesn't skew the measurement.
        const { offsetWidth: width, offsetHeight: height } = card
        const gap = 10
        const edge = 12
        const left = Math.min(
          window.innerWidth - width - edge,
          Math.max(edge, linkRect.left + (linkRect.width - width) / 2),
        )
        const aboveTop = linkRect.top - height - gap
        const overlaps = (top: number) => avoid.some((box) =>
          top < box.bottom && top + height > box.top && left < box.right && left + width > box.left)
        const above = aboveTop >= edge && !overlaps(aboveTop)
        const top = above ? aboveTop : linkRect.bottom + gap

        card.style.left = `${Math.round(left)}px`
        card.style.top = `${Math.round(top)}px`
        card.dataset.placement = above ? 'above' : 'below'
        // Scale from the link, even when the card is shifted to stay on screen.
        const originX = linkRect.left + linkRect.width / 2 - left
        card.style.transformOrigin = `${Math.round(originX)}px ${above ? 'bottom' : 'top'}`
        return { top, bottom: top + height, left, right: left + width }
      }

      const applyStylesNow = (element: HTMLElement) => element.getBoundingClientRect()

      const openCard = (card: HTMLElement, link: HTMLAnchorElement, avoid: Box[] = [], instant = false) => {
        card.setAttribute('data-instant', '')
        const box = placeCard(card, link, avoid)
        applyStylesNow(card)
        card.toggleAttribute('data-instant', instant)
        card.dataset.open = ''
        return box
      }

      const previewSrc = (link: HTMLAnchorElement) => {
        const key = previewKey(link.href)
        return (key && linkPreviews[key]) || ''
      }

      const wireCardImage = (card: HTMLElement) => {
        const media = card.querySelector<HTMLElement>('[data-external-preview-media]')
        const image = card.querySelector<HTMLImageElement>('[data-external-preview-image]')
        image?.addEventListener('error', () => media?.setAttribute('data-failed', ''))
        image?.addEventListener('load', () => media?.setAttribute('data-loaded', ''))
      }

      const setCardImage = (card: HTMLElement, link: HTMLAnchorElement) => {
        const media = card.querySelector<HTMLElement>('[data-external-preview-media]')
        const image = card.querySelector<HTMLImageElement>('[data-external-preview-image]')
        if (!media || !image) return
        const src = previewSrc(link)
        // No thumbnail (screenshot and og:image both failed at build time).
        if (!src) {
          image.removeAttribute('src')
          media.removeAttribute('data-loaded')
          media.setAttribute('data-failed', '')
          return
        }
        image.src = src
        media.removeAttribute('data-failed')
        media.toggleAttribute('data-loaded', image.complete && image.naturalWidth > 0)
      }

      if (preview) wireCardImage(preview)

      const showExternalPreview = (link: HTMLAnchorElement, keyboard = false) => {
        if (!preview || isPinchZoomed()) return
        activeExternalLink = link
        setCardImage(preview, link)
        openCard(preview, link, [], keyboard)
      }

      // Keyboard actions never animate. A card opened by keyboard also closes instantly.
      const hideExternalPreview = (link?: HTMLAnchorElement, keyboard = false) => {
        // Cancel first: the pointer can leave before the preview has opened.
        window.clearTimeout(previewTimer)
        if (link && activeExternalLink !== link) return
        activeExternalLink = null
        if (keyboard) preview?.setAttribute('data-instant', '')
        preview?.removeAttribute('data-open')
      }

      const keepArrowWithLastWord = (link: HTMLAnchorElement) => {
        const lastWordWithArrow = document.createElement('span')
        lastWordWithArrow.className = 'whitespace-nowrap'
        lastWordWithArrow.dataset.externalArrow = ''
        const walker = document.createTreeWalker(link, NodeFilter.SHOW_TEXT)
        let lastText: Text | null = null
        while (walker.nextNode()) {
          if (walker.currentNode.textContent?.trim()) lastText = walker.currentNode as Text
        }
        const wordStart = lastText?.data.search(/\S+\s*$/) ?? -1
        if (!lastText || wordStart < 0) {
          link.append(lastWordWithArrow)
          return
        }
        const lastWord = lastText.splitText(wordStart)
        lastWord.replaceWith(lastWordWithArrow)
        lastWordWithArrow.append(lastWord)
      }

      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        const url = new URL(link.href, window.location.href)
        const isExternal = /^https?:$/.test(url.protocol) && url.origin !== window.location.origin

        link.dataset.linkKind = isExternal ? 'external' : 'internal'
        if (isExternal) {
          link.target = '_blank'
          link.rel = 'noopener noreferrer'
          keepArrowWithLastWord(link)

          const externalLabel = document.createElement('span')
          externalLabel.className = 'sr-only'
          externalLabel.textContent = ' (external link)'
          link.append(externalLabel)

          // Only body text links get a site preview.
          if (!link.matches(BODY_LINKS)) continue

          link.addEventListener('pointerenter', () => {
            if (!hoverQuery.matches) return
            window.clearTimeout(previewTimer)
            previewTimer = window.setTimeout(() => showExternalPreview(link), 240)
          })
          link.addEventListener('pointerleave', () => hideExternalPreview(link))
          link.addEventListener('focus', () => {
            // Skip focus from mouse clicks, which would leave the preview stuck open.
            if (link.matches(':focus-visible')) showExternalPreview(link, true)
          })
          link.addEventListener('click', (event) => hideExternalPreview(link, event.detail === 0))
          link.addEventListener('blur', () => hideExternalPreview(link))
        }
      }

      window.visualViewport?.addEventListener('resize', () => {
        if (isPinchZoomed()) hideExternalPreview()
      })
      window.addEventListener('resize', () => {
        if (activeExternalLink && preview) placeCard(preview, activeExternalLink)
      })
      window.addEventListener('scroll', () => {
        if (activeExternalLink && preview) placeCard(preview, activeExternalLink)
      }, true)
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hideExternalPreview(undefined, true)
      })

      const touchQuery = window.matchMedia('(hover: none) and (pointer: coarse)')
      const TAP_MAX_DURATION = 300
      const TAP_SLOP = 10
      const DOUBLE_TAP_GAP = 300
      const DOUBLE_TAP_SLOP = 40
      const TOAST_DURATION = 4000
      const TOAST_FADE = 400
      let toastTimer: number | undefined
      let press: { id: number, x: number, y: number, time: number, region: HTMLElement } | null = null
      let lastTap: { x: number, y: number, time: number } | null = null
      let toasts: { card: HTMLElement, link: HTMLAnchorElement }[] = []
      const preloaded = new Set<string>()

      const isPreviewLink = (link: HTMLAnchorElement) => link.dataset.linkKind === 'external'

      const showAllPreviews = (region: HTMLElement) => {
        if (!preview) return
        const links = Array.from(region.querySelectorAll<HTMLAnchorElement>(BODY_LINKS)).filter(isPreviewLink)
        const placed: Box[] = []
        toasts = links.map((link) => {
          const card = preview.cloneNode(true) as HTMLElement
          for (const name of ['id', 'data-external-preview', 'data-open', 'data-instant']) card.removeAttribute(name)
          card.dataset.toast = ''
          document.body.append(card)
          wireCardImage(card)
          setCardImage(card, link)
          placed.push(openCard(card, link, placed))
          link.setAttribute('data-previewing', '')
          return { card, link }
        })
        toastTimer = window.setTimeout(() => hideAllPreviews('toast'), TOAST_DURATION)
      }

      const hideAllPreviews = (pace: 'quick' | 'toast' = 'quick') => {
        window.clearTimeout(toastTimer)
        for (const { card, link } of toasts) {
          card.toggleAttribute('data-quick', pace === 'quick')
          card.removeAttribute('data-open')
          link.removeAttribute('data-previewing')
          if (pace === 'toast') {
            link.setAttribute('data-fading', '')
            window.setTimeout(() => link.removeAttribute('data-fading'), TOAST_FADE)
          }
          window.setTimeout(() => card.remove(), TOAST_FADE)
        }
        toasts = []
      }

      // Start fetching screenshots on the first tap so the first card isn't an empty box.
      const preloadPreviews = (region: HTMLElement) => {
        for (const link of region.querySelectorAll<HTMLAnchorElement>(BODY_LINKS)) {
          if (!isPreviewLink(link)) continue
          const src = previewSrc(link)
          if (!src || preloaded.has(src)) continue
          preloaded.add(src)
          new Image().src = src
        }
      }

      document.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'touch' || !touchQuery.matches) return
        const target = event.target instanceof Element ? event.target : null
        const region = target?.closest<HTMLElement>('[data-reveal-region]')
        // Tapping a link, or anywhere outside the region, ends the mode and isn't a double-tap.
        if (!region || target?.closest('a, button')) {
          press = null
          lastTap = null
          hideAllPreviews()
          return
        }
        press = { id: event.pointerId, x: event.clientX, y: event.clientY, time: event.timeStamp, region }
        preloadPreviews(region)
      }, true)

      document.addEventListener('pointerup', (event) => {
        if (!press || event.pointerId !== press.id) return
        const { x, y, time, region } = press
        press = null
        const isTap = event.timeStamp - time < TAP_MAX_DURATION
          && Math.hypot(event.clientX - x, event.clientY - y) < TAP_SLOP
        if (!isTap) return
        const isDoubleTap = lastTap
          && time - lastTap.time < DOUBLE_TAP_GAP
          && Math.hypot(x - lastTap.x, y - lastTap.y) < DOUBLE_TAP_SLOP
        if (isDoubleTap) {
          lastTap = null
          showAllPreviews(region)
          return
        }
        // A single tap leaves the mode right away, so the second tap of a double-tap is a no-op.
        if (toasts.length) {
          lastTap = null
          hideAllPreviews()
          return
        }
        lastTap = { x, y, time }
      }, true)

      document.addEventListener('pointercancel', () => {
        press = null
      }, true)
      window.addEventListener('scroll', () => hideAllPreviews(), true)
    </script>
  </body>
</html>
